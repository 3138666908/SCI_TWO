INPUT INSTRUCTIONS

  TITLE: CHARLS k=3 fgmm lin;
  DATA: FILE IS data/CHARLS_train.dat;
  VARIABLE:
    NAMES ARE id y1 y2 y3;
    USEV = y1 y2 y3;
    MISSING = ALL (-999);
    IDVARIABLE = id;
    CLASSES = c(3);
  ANALYSIS: TYPE = MIXTURE;
    STARTS = 300 50;
    LRTBOOTSTRAP = 100;
    PROCESSORS = 4;
  MODEL:
    %OVERALL%
    i BY y1@1 y2@1 y3@1;
    s BY y1@0 y2@2 y3@5;
    y1-y3 (res);
  OUTPUT: TECH11 TECH14;
  SAVEDATA: FILE = cmp_gmm_CHARLS_cprob.dat; SAVE = CPROB; FORMAT = FREE;



