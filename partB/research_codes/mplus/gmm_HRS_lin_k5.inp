TITLE: HRS k=5 gmm lin;
DATA: FILE IS data/HRS.dat;
VARIABLE:
  NAMES ARE id y1 y2 y3 y4;
  USEV = y1 y2 y3 y4;
  MISSING = ALL (-999);
  CLASSES = c(5);
ANALYSIS: TYPE = MIXTURE;
  STARTS = 300 50;
  LRTBOOTSTRAP = 100;
  PROCESSORS = 4;
MODEL:
  %OVERALL%
  i BY y1@1 y2@1 y3@1 y4@1;
  s BY y1@0 y2@4 y3@8 y4@12;
  y1-y4 (res);
OUTPUT: TECH11 TECH14;
